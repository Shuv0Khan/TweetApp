# Copy this file to .env and fill in your own values. .env is git-ignored.

# Twitter/X API v2 credentials (utils/constants.py, twitterdev/api_relay.py)
TWITTER_API_KEY=your-api-key
TWITTER_API_SECRET=your-api-secret
TWITTER_BEARER_TOKEN=your-bearer-token

# Google Perspective API key (perspective_api/*.py)
PERSPECTIVE_API_KEY=your-google-api-key

# Neo4j connection (core/neo4j_processor.py)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-neo4j-password

# Crash alert email sent by main.py (use a Gmail app password)
ALERT_EMAIL_SENDER=sender@example.com
ALERT_EMAIL_PASSWORD=your-app-password
ALERT_EMAIL_RECIPIENT=you@example.com
